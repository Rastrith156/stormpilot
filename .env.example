# StormPilot environment template
GOOGLE_MAPS_API_KEY=
# Generate a high-entropy value of at least 32 bytes; never commit the real secret.
STORMPILOT_ADMIN_TOKEN=
STORMPILOT_HOST_PORT=8080
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
DELIVERY_NOTIFICATION_TO=
APP_DATA_DIR=./.stormpilot_data
DATA_RETENTION_DAYS=30
ARRIVAL_GEOFENCE_RADIUS_M=50
REDMINE_URL=https://redmine.example.internal
REDMINE_API_KEY=
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-local-password
APP_HOSTNAME=stormpilot.example.internal
DOCKER_PRIVATE_SUBNET=172.30.80.0/24
OIDC_ISSUER_URL=https://identity.example.com
OIDC_CLIENT_ID=stormpilot
OIDC_ALLOWED_EMAIL_DOMAIN=example.com
REDMINE_API_KEY_FILE=./secrets/redmine_api_key
OIDC_CLIENT_SECRET_FILE=./secrets/oidc_client_secret
OAUTH_COOKIE_SECRET_FILE=./secrets/oauth_cookie_secret